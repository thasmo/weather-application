{
	"type": "module",
	"private": true,
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "vp dev",
		"preview": "vp preview",
		"build": "vp build",
		"deploy": "void deploy --platform cloudflare",
		"upload": "wrangler versions upload --config dist/ssr/wrangler.json",
		"prepare": "concurrently --group --prefix-colors 'auto' 'pnpm:prepare:*'",
		"prepare:hooks": "vp config --no-agent",
		"lint": "concurrently --group --prefix-colors 'auto' 'pnpm:lint:*'",
		"lint:types": "vue-tsc --noEmit",
		"lint:eslint": "eslint .",
		"lint:cspell": "cspell --no-progress --no-summary --no-must-find-files .",
		"lint:knip": "knip --no-progress",
		"fix": "concurrently --group --prefix-colors 'auto' 'pnpm:fix:*'",
		"fix:eslint": "eslint --fix .",
		"fix:knip": "knip --fix --no-progress --workspace ."
	},
	"dependencies": {
		"@ark-ui/vue": "^5.14.2",
		"@iconify-json/ri": "^1.2.5",
		"@iconify-json/wi": "^1.2.1",
		"@vueuse/core": "^15.0.0",
		"openmeteo": "^1.2.0",
		"pinia": "^4.0.0",
		"pinia-plugin-persistedstate": "^4.3.0",
		"vue": "^3.5.13",
		"vue-i18n": "^11.1.6",
		"vue-router": "^5.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.0",
		"@iconify/utils": "^3.0.0",
		"@somehow-digital/commitlint-config": "^1.0.0",
		"@somehow-digital/cspell-dictionary": "^2.7.0",
		"@somehow-digital/eslint-config": "^5.0.0",
		"@somehow-digital/typescript-config": "^3.0.0",
		"@tsconfig/node24": "^24.0.0",
		"@types/node": "^26.0.0",
		"@unocss/preset-web-fonts": "^66.3.1",
		"@unocss/reset": "^66.0.0",
		"@vitejs/plugin-vue": "^6.0.0",
		"@vue/tsconfig": "^0.9.0",
		"concurrently": "^10.0.0",
		"cspell": "^10.0.0",
		"eslint": "^10.0.0",
		"jiti": "^2.4.2",
		"knip": "^6.0.0",
		"typescript": "^6.0.0",
		"unocss": "^66.0.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plugin-vue-devtools": "^8.0.0",
		"vite-plus": "1.4.0",
		"void": "^1.4.0",
		"vue-tsc": "^3.0.0",
		"wrangler": "^4.155.0"
	}
}
